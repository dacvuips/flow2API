{
  "manifest_version": 3,
  "name": "Flow2API Bridge",
  "version": "0.1.4",
  "description": "Flow2API — Bridge (proxy API + inject captcha) hoặc Captcha Center (mint reCAPTCHA cho pool profiles). Chọn mode ở popup.",
  "permissions": [
    "storage",
    "alarms",
    "tabs",
    "webRequest",
    "webRequestAuthProvider",
    "proxy",
    "scripting",
    "declarativeNetRequest",
    "cookies",
    "browsingData"
  ],
  "host_permissions": [
    "https://aisandbox-pa.googleapis.com/*",
    "https://labs.google/*",
    "https://*.google.com/*",
    "https://google.com/*",
    "https://*.recaptcha.net/*",
    "https://recaptcha.net/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Flow2API Bridge",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://labs.google/fx/tools/flow*",
        "https://labs.google/fx/*/tools/flow*",
        "https://labs.google/fx",
        "https://labs.google/fx/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["injected.js"],
      "matches": ["https://labs.google/*"]
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "flow2api_rules",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
